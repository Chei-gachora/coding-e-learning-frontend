# Copy to .env.docker (git-ignored). Real values only — this file is read at
# container start; it is never copied into an image.
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your.domain
CORS_ALLOWED_ORIGINS=https://your.domain
FRONTEND_URL=https://your.domain

MSSQL_DB_NAME=optimum_erp_lms
MSSQL_DB_USER=django_lms
MSSQL_DB_PASSWORD=replace-with-a-long-random-secret
MSSQL_DB_HOST=host.docker.internal
MSSQL_DB_PORT=1433
MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_EXTRA_PARAMS=Encrypt=yes;TrustServerCertificate=no;

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email-service-user
EMAIL_HOST_PASSWORD=replace-with-your-email-service-password
DEFAULT_FROM_EMAIL="Optimum LMS <no-reply@your.domain>"

# SANDBOX_TOKEN is supplied by docker-compose (export it in your shell / compose .env)
