# Copy this file to .env only if a local .env does not already exist.
# Never commit .env itself.

DJANGO_SECRET_KEY=replace-with-a-random-secret-for-local-development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# --- Microsoft SQL Server ---
MSSQL_DB_NAME=optimum_lms_v2
MSSQL_DB_HOST=localhost
MSSQL_DB_PORT=
MSSQL_DB_TRUSTED_CONNECTION=True
MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# Local Windows authentication with a default SQL Server instance and TCP disabled.
# Production: Encrypt=yes;TrustServerCertificate=no;
# Local SQL Server without a trusted certificate: Encrypt=yes;TrustServerCertificate=yes;
MSSQL_EXTRA_PARAMS=Encrypt=yes;TrustServerCertificate=yes;
DB_CONN_MAX_AGE=60

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# OAuth client IDs (configure the matching public client IDs in frontend/.env.local)
GOOGLE_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=

# Production email delivery (development uses the console mailer)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email-service-user
EMAIL_HOST_PASSWORD=your-email-service-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL="Optimum LMS <no-reply@example.com>"

# External code-execution sandbox (see apps/execution/views.py)
SANDBOX_URL=http://localhost:9000
SANDBOX_TOKEN=

# Account links, uploads, and reverse proxies
PASSWORD_RESET_TIMEOUT=3600
EMAIL_VERIFICATION_TIMEOUT=86400
SUBMISSION_MAX_UPLOAD_MB=10
# Set to 1 behind nginx/a load balancer; keep 0 for local development.
NUM_PROXIES=0
